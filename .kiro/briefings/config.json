{
  "_comment": "简报采集配置。改这个文件不用改脚本代码。每次 ingest/classify 都会读一遍。",
  "freshness_hours": 48,
  "published_index_retention_days": 60,
  "run_retention_days": 30,
  "source_circuit_breaker": {
    "fail_threshold_days": 2,
    "skip_when_tripped": true
  },
  "main_topic_rules": {
    "_comment": "一条内容同时命中多个 tag 时，决定它的 primary topic。curate 阶段优先给 main topic 收录。",
    "priority": ["ai-agent", "china-tech", "global-tech"]
  },
  "candidates_top_n": {
    "_comment": "candidates 阶段每个 topic 的 top-N 上限。不同 topic 候选池规模差距大（ai-agent 通常 ≥5x global-tech），一刀切会让信息密集主题损失太多候选。CLI --top-n 显式传值时覆盖此配置。",
    "_default": 60,
    "ai-agent": 100,
    "china-tech": 80,
    "global-tech": 100
  },
  "rss_sources": [
    {"name": "LangChain Blog", "url": "https://blog.langchain.com/rss.xml", "topic_hints": ["ai-agent"]},
    {"name": "Anthropic Research", "url": "https://raw.githubusercontent.com/Olshansk/rss-feeds/main/feeds/feed_anthropic_research.xml", "topic_hints": ["ai-agent"], "timeout": 30},
    {"name": "Anthropic News", "url": "https://raw.githubusercontent.com/Olshansk/rss-feeds/main/feeds/feed_anthropic_news.xml", "topic_hints": ["ai-agent"], "timeout": 30},
    {"name": "OpenAI Blog", "url": "https://openai.com/blog/rss.xml", "topic_hints": ["ai-agent"], "max_items": 80},
    {"name": "Google AI Blog", "url": "https://blog.google/technology/ai/rss/", "topic_hints": ["ai-agent"]},
    {"name": "Hugging Face Blog", "url": "https://huggingface.co/blog/feed.xml", "fallback_url": "https://raw.githubusercontent.com/Olshansk/rss-feeds/main/feeds/feed_huggingface_blog.xml", "topic_hints": ["ai-agent"], "timeout": 25, "retries": 4},
    {"name": "Wired AI", "url": "https://www.wired.com/feed/tag/ai/latest/rss", "topic_hints": ["ai-agent"]},
    {"name": "arXiv AI", "url": "https://rss.arxiv.org/rss/cs.AI", "topic_hints": ["ai-agent"]},
    {"name": "HN AI 关键词 A", "url": "https://hnrss.org/newest?q=AI+agent+OR+MCP+OR+LLM&points=30", "topic_hints": ["ai-agent"], "timeout": 25, "retries": 4, "algolia_fallback": {"query": "AI agent MCP LLM", "tags": "story", "points_min": 30, "hits_per_page": 30}},
    {"name": "HN AI 关键词 B", "url": "https://hnrss.org/newest?q=LangGraph+OR+CrewAI+OR+Claude+OR+RAG+OR+function+calling+OR+context+engineering&points=20", "topic_hints": ["ai-agent"], "timeout": 25, "retries": 4, "algolia_fallback": {"query": "LangGraph CrewAI Claude RAG", "tags": "story", "points_min": 20, "hits_per_page": 25}},

    {"name": "36氪", "url": "https://36kr.com/feed", "topic_hints": ["china-tech"]},
    {"name": "InfoQ CN", "url": "https://www.infoq.cn/feed", "topic_hints": ["china-tech"]},
    {"name": "量子位", "url": "https://www.qbitai.com/feed", "topic_hints": ["china-tech"]},
    {"name": "开源中国", "url": "https://www.oschina.net/news/rss", "topic_hints": []},
    {"name": "少数派", "url": "https://sspai.com/feed", "topic_hints": ["china-tech"]},
    {"name": "IT之家", "url": "https://www.ithome.com/rss/", "topic_hints": ["china-tech"]},
    {"name": "HN 中国科技", "url": "https://hnrss.org/newest?q=DeepSeek+OR+Qwen+OR+Baidu+AI+OR+China+AI&points=10", "topic_hints": ["china-tech"], "timeout": 25, "retries": 4, "algolia_fallback": {"query": "DeepSeek Qwen China AI", "tags": "story", "points_min": 10, "hits_per_page": 20}},

    {"name": "HN Top", "url": "https://hnrss.org/frontpage?count=30", "topic_hints": ["global-tech"]},
    {"name": "TechCrunch", "url": "https://techcrunch.com/feed/", "topic_hints": ["global-tech"]},
    {"name": "The Verge", "url": "https://www.theverge.com/rss/index.xml", "topic_hints": ["global-tech"]},
    {"name": "Ars Technica", "url": "https://feeds.arstechnica.com/arstechnica/index", "topic_hints": ["global-tech"]},
    {"name": "GitHub Blog", "url": "https://github.blog/feed/", "topic_hints": ["global-tech"]},
    {"name": "Product Hunt", "url": "https://www.producthunt.com/feed", "topic_hints": ["global-tech"]},
    {"name": "AWS Blog", "url": "https://aws.amazon.com/blogs/aws/feed/", "topic_hints": ["global-tech"]},
    {"name": "Cloudflare Blog", "url": "https://blog.cloudflare.com/rss/", "topic_hints": ["global-tech"]},
    {"name": "Kubernetes Blog", "url": "https://kubernetes.io/feed.xml", "topic_hints": ["global-tech"]},
    {"name": "HN 开发者", "url": "https://hnrss.org/newest?q=Rust+OR+TypeScript+OR+Kubernetes+OR+AWS+OR+security+vulnerability&points=20", "topic_hints": ["global-tech"], "timeout": 25, "retries": 4, "algolia_fallback": {"query": "Rust TypeScript Kubernetes security", "tags": "story", "points_min": 20, "hits_per_page": 25}}
  ],
  "classify_rules": {
    "ai-agent": {
      "keywords": [
        "ai agent", "llm", "gpt", "claude", "gemini", "openai", "anthropic",
        "langchain", "langgraph", "crewai", "autogen", "llamaindex",
        "mcp", "model context protocol", "rag", "retrieval augmented",
        "fine-tuning", "fine tuning", "prompt engineering", "context engineering",
        "function calling", "tool use", "tool calling", "agentic",
        "deepseek", "qwen", "通义", "文心", "豆包", "kimi", "智谱", "glm",
        "huggingface", "hugging face", "transformers",
        "arxiv", "benchmark", "eval",
        "inference", "vllm", "ollama"
      ]
    },
    "china-tech": {
      "_comment": "china-tech 关键词只放真正的中国语境信号。不要把站点名（开源中国/IT之家/InfoQ CN/量子位/36氪/少数派）当关键词——RSS 源 source 字段已带这些字，会让该源所有内容（含国际新闻）误判为 china-tech。纯模型名（如 kimi/qwen/deepseek）放在 ai-agent，这里只放厂商主体。",
      "keywords": [
        "阿里", "腾讯", "字节", "百度", "美团", "京东", "华为", "小米",
        "蚂蚁", "网易", "快手", "拼多多", "滴滴", "理想", "小鹏", "蔚来",
        "vivo", "oppo", "荣耀", "中兴", "联想",
        "baidu", "alibaba", "tencent", "bytedance",
        "moonshot", "月之暗面", "智谱", "面壁", "minimax", "阶跃星辰",
        "米哈游", "鸿蒙", "余承东", "雷军",
        "中国", "国内", "国产", "大陆", "出海", "信创",
        "国产算力", "国产 gpu", "国产芯片", "国产模型",
        "工信部", "网信办", "发改委", "备案"
      ]
    },
    "global-tech": {
      "keywords": [
        "apple", "google", "microsoft", "meta", "amazon", "netflix", "nvidia",
        "github", "gitlab", "atlassian",
        "rust", "golang", " go ", "typescript", "javascript", "python",
        "react", "vue", "svelte", "node.js", "nodejs", "deno", "bun",
        "aws", "gcp", "azure", "cloudflare", "vercel", "netlify",
        "kubernetes", "docker", "terraform",
        "cve", "vulnerability", "zero day", "0-day", "exploit", "ransomware",
        "data breach", "supply chain attack",
        "product hunt", "release", "launches", "ipo"
      ]
    }
  },
  "noise_keywords": [
    "sponsored", "advertorial", "press release",
    "showcase", "promo"
  ],
  "score_overrides": {
    "_comment": "per-topic primacy 权重覆盖。key 是 topic，value 是 source 子串→权重的映射。默认全部按 global 规则。",
    "china-tech": {
      "primacy_sources": {
        "开源中国": 5,
        "infoq": 5,
        "36氪": 3,
        "量子位": 4,
        "IT之家": 3,
        "少数派": 3,
        "supplement/bilibili": 3,
        "supplement/v2ex": 3
      }
    },
    "ai-agent": {
      "primacy_sources": {
        "follow-builders": 4
      }
    }
  },
  "follow_builders": {
    "_comment": "头部 AI builder 的 X 推文 + 播客转录，来自 zarazhangrui/follow-builders 中心化 feed（无 key）。blogs 不启用（与现有 Anthropic RSS 重复）。",
    "enabled": true,
    "feed_base_url": "https://raw.githubusercontent.com/zarazhangrui/follow-builders/main",
    "feeds": ["x", "podcasts"],
    "timeout": 20,
    "x_min_likes": 50,
    "x_max_per_author": 2,
    "podcast_description_chars": 300
  },
  "llm_classify": {
    "enabled": true,
    "borderline_only": true,
    "provider": "anthropic",
    "model": "claude-3-5-haiku-20241022",
    "_comment": "borderline_only=true 时仅对规则未命中 tag 的条目调 LLM。无 key 时自动退回规则。"
  },
  "semantic_dedup": {
    "enabled": true,
    "threshold": 0.85,
    "_comment": "启用后使用 title+description 的 shingle Jaccard 做近义去重。"
  },
  "supplement_sources": {
    "_comment": "补充采集层：Agent-Reach 理念的生产落地。只接无 Cookie 源；结果并入 pool.jsonl 走 classify。本机有 bili-cli 时自动优先 CLI。",
    "enabled": true,
    "bilibili": {
      "enabled": true,
      "queries": [
        "DeepSeek 大模型",
        "AI Agent 教程"
      ],
      "max_per_query": 5,
      "topic_hints": ["china-tech", "ai-agent"]
    },
    "v2ex": {
      "enabled": true,
      "include_hot": true,
      "nodes": ["programmer", "cloud", "create"],
      "max_per_node": 8,
      "topic_hints": ["ai-agent", "global-tech"]
    }
  }
}
