# 简报流水线可选配置（复制为 .env 后填写）
# cp .env.example .env

# LLM 边界补标（classify 阶段 borderline 条目，默认走 OpenAI 兼容网关）
OPENAI_API_KEY=llmgtwy_...
OPENAI_API_BASE=https://llm-gw.agenzo.com/v1
OPENAI_MODEL=aws-bedrock/claude-haiku-4-5

# 若改回 Anthropic 直连，在 config.json 设 provider=anthropic 并填写：
# ANTHROPIC_API_KEY=sk-ant-...

# Bark 推送（也可从 personal-brand-agent/.env 自动读取）
# BARK_URL=https://api.day.app/your_key/
